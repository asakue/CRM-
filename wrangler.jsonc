{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hospital-crm",
  "compatibility_date": "2026-09-17",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hospital-crm-db",
      "database_id": "local-dev-placeholder"
    }
  ],
  "vars": {
    "APP_NAME": "Hospital CRM",
    // PBKDF2 iterations (max 100000 in workerd; 25000 fits the free CPU budget)
    "PBKDF2_ITERATIONS": "25000"
  }
}
