{
  "name": "hospital-crm",
  "version": "1.0.0",
  "type": "module",
  "description": "Медицинская CRM для больницы: пациенты, врачи, записи, анализы, статистика, роли и шифрование",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "wrangler pages dev dist --ip 0.0.0.0 --port 3000",
    "dev:sandbox": "wrangler pages dev dist --ip 0.0.0.0 --port 3000",
    "dev:d1": "wrangler pages dev dist --d1=hospital-crm-db --local --ip 0.0.0.0 --port 3000",
    "deploy": "npm run build && wrangler pages deploy dist --project-name hospital-crm",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "clean-port": "fuser -k 3000/tcp 2>/dev/null || true",
    "test": "curl http://localhost:3000/api/health",
    "seed:generate": "node scripts/generate-seed.mjs",
    "db:migrate:local": "wrangler d1 migrations apply hospital-crm-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply hospital-crm-db",
    "db:seed": "wrangler d1 execute hospital-crm-db --local --file=./seed.sql",
    "db:reset": "rm -rf .wrangler/state && npm run db:migrate:local && npm run db:seed",
    "db:console:local": "wrangler d1 execute hospital-crm-db --local",
    "db:console:prod": "wrangler d1 execute hospital-crm-db"
  },
  "dependencies": {
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250705.0",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  }
}
